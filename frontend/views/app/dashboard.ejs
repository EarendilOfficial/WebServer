<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Eärendil</title>
        <link rel="icon" type="image/x-icon" href="../resources/icons/logo/icon_A_mini.png">
        <link rel="stylesheet" href="/pages/dashboard/style.css">
        <link rel="stylesheet" href="/pages/dashboard/playerdata.css">
        <link rel="stylesheet" href="/plantilla.css">
    </head>

    <!-- /_ -->
    <!-- _/ -->

    <body id="body">
        <!-- Icono de carga de la pagina -->
        <div id="loading-overlay" class="shown">
            <img src="../resources/icons/start_terminator.png" alt="[">
            <img src="../resources/icons/middle_terminator.png" alt="O">
            <img src="../resources/icons/end_terminator.png" alt="]">
        </div>

        <!-- Header del sitio web -->
        <%- include('../.parts/header.ejs'); %>

        <!-- CUERPO PRINCIPAL DEL SITIO WEB -->
        <!--            inicia              -->
        <!--   CUERPO PRINCIPAL DE PANELES  -->
        <main class="dashboard-grid">

            <!-- Mensaje semanal del Administrador -->
            <section class="latest-content">
                Loading latest content...
            </section>
            

            <aside class="status-panel">
                
                <!-- Panel de status del jugador -->
                <div class="status-card player-info-card">
                    <div class="player-header">
                        <img class="player-icon" src="../resources/icons/sections/user_icon.png" alt="Icono de Jugador">
                        <span class="player-name value">SamloGamer</span>
                    </div>

                    <div class="player-stats">
                        <h3 class="card-title">Información del jugador</h3>
                        <div class="stat-row">
                            <span class="stat-label">Nivel:</span>
                            <span id="player-level" class="stat-value">55</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">Rango:</span>
                            <span id="player-rank" class="stat-value rank-color">Plebeyo</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">Ringcoins:</span>
                            <span id="player-ringcoins" class="stat-value money-yellow">536🪙</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">Reputación:</span>
                            <span id="player-reputation" class="stat-value reputation-good">Alta (+150)</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">Clan:</span>
                            <span id="player-clan" class="stat-value clan-tag">[ÉAR] Eärendil</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">Misiones Completadas:</span>
                            <span id="player-finishedMissions" class="stat-value missions">42</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">Kills:</span>
                            <span id="player-killcount" class="stat-value kill-count">987</span>
                        </div>
                    </div>

                </div>

                
                <div class="status-card latest-update">
                    <h3>Última Actualización: V1.19.4</h3>
                    <img src="/resources/icons/logo/earendil_conquer.png" alt="Imagen del Último Update" class="update-image">
                    <p class="description">Descripcion</p>
                    <p class="version">Versión del Servidor: **1.20.1**</p>
                </div>
                
                <div class="status-card active-events">
                    <h3>Eventos Activos</h3>
                    <ul class="event-list">
                        <li class="no-events">No hay eventos programados.</li>
                    </ul>
                </div>

                <div class="status-card active-players">
                    <div class="close-row">
                        <img src="../resources/icons/sections/social_icon2.png" alt="Jugadores">
                        <span id="active_players" class="value">1</span>
                    </div>
                    <p>Jugadores Registrados</p>
                </div>
                
            </aside>
        </main>

        
        <!-- Footer del sitio web (Panel de info general al fondo de la pagina) -->
        <%- include('../.parts/footer'); %>

        <script src="/pages/dashboard/script.js"></script> 
        <script src="/resources/js/announcement_Render.js"></script> 
    </body>
</html>