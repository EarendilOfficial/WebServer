<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Eärendil - Admin Blogs</title>
        <link rel="icon" type="image/x-icon" href="../resources/icons/logo/icon_A_mini.png">
        
        <link rel="stylesheet" href="/pages/dashboard/style.css"> 
        <link rel="stylesheet" href="pages/edit_announcements/admin_styles.css"> 
        <link rel="stylesheet" href="/plantilla.css"> 
    </head>

    <body id="body">
        <div id="loading-overlay" class="shown">
            <img src="/resources/icons/start_terminator.png" alt="[">
            <img src="/resources/icons/middle_terminator.png" alt="O">
            <img src="/resources/icons/end_terminator.png" alt="]">
        </div>
        
        <%- include('../.parts/headerAdmin'); %>
        

        <!-- Contenido de admin-blogs (sirve para elegir los blogs que se va a editar) -->
        <div class="container">
            <h1 class="mb-4">Blogs</h1>
            <a href="/admin/admin-blogs/new" class="btn btn-success mb-3">Nuevo blog</a>

            <% articles.forEach(article => { %>
                <div class="card mb-4">
                <div class="card-body">
                        <h5 class="card-title"><%= article.title %></h5>
                        <div class = "card-subtitle text-muted mb-2"> 
                            <%= article.createdAt.toLocaleDateString() %>
                        </div>
                        <div class="card-text mb-2"><%= article.description %></div>
                        <a href="/admin/admin-blogs/view/<%= article.slug %>" class="btn btn-primary">Leer mas</a>
                        <a href="/admin/admin-blogs/edit/<%= article.id %>" class="btn btn-info">Editar</a>
                        <form action="/admin/admin-blogs/<%= article.id%>?_method=DELETE" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-danger">Borrar</button>
                        </form>
                    </div>
                    </div>
            <% }) %> 
        </div>
    
        <!-- Footer de la pagina -->
        <%- include('../.parts/footer.ejs'); %>
        <script src="pages/edit_announcements/admin_styles.js"></script> 
        <script src="/resources/js/announcement_Render.js"></script> 
</body>
</html>