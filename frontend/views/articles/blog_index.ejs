<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Eärendil</title>
        <link rel="icon" type="image/x-icon" href="../resources/icons/logo/icon_A_mini.png">
        <link rel="stylesheet" href="../pages/dashboard/style.css">
        <link rel="stylesheet" href="../pages/dashboard/playerdata.css">
        <link rel="stylesheet" href="/plantilla.css">
    </head>

    <!-- /_ -->
    <!-- _/ -->

    <body id="body">
        <%- include('../.parts/header.ejs'); %>


            <div class="container">
                <h1 class="mb-4">Blogs</h1>

                <% articles.forEach(article => { %>
                    <div class="card mb-4">
                    <div class="card-body">
                            <h5 class="card-title"><%= article.title %></h5>
                            <div class = "card-subtitle text-muted mb-2"> 
                                <%= article.createdAt.toLocaleDateString() %>
                            </div>
                            <div class="card-text mb-2"><%= article.description %></div>
                            <a href="news/view/<%= article.slug %>" class="btn btn-primary">Leer mas</a>
                            </form>
                        </div>
                        </div>
                <% }) %> 
            </div>
    
        <%- include("../.parts/footer") %>
        <script src="../pages/dashboard/script.js"></script> 
        <script src="/resources/js/announcement_Render.js"></script> 
    </body>
</html>