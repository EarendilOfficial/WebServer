<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Eärendil</title>
        <link rel="icon" type="image/x-icon" href="/resources/icons/logo/icon_A_mini.png">
        <link rel="stylesheet" href="/pages/dashboard/style.css">
        <link rel="stylesheet" href="/pages/dashboard/playerdata.css">
        <link rel="stylesheet" href="/plantilla.css">
    </head>

    <!-- /_ -->
    <!-- _/ -->

    <body id="body">
        <!-- Icono de carga de la pagina -->
        <div id="loading-overlay" class="shown">
            <img src="/resources/icons/start_terminator.png" alt="[">
            <img src="/resources/icons/middle_terminator.png" alt="O">
            <img src="/resources/icons/end_terminator.png" alt="]">
        </div>


        <!-- Seccion de arriba donde se encuentra el logo oscurecido -->
        <section class="upper_coating">0.1.1</section>
        
        <!-- Barra de arriba (o header) de la pagina web -->
        <div class="header">
            <ul class="nav_links">
                <!-- Iconos de navegacion (links paginas) -->
                <li class="nav_links_text"><a href="./news"><img src="/resources/icons/sections/news_icon.png" alt="Noticias">Noticias</a></li>
                <li class="nav_links_text"><a href="/social"><img src="/resources/icons/sections/social_icon2.png" alt="Social">Social</a></li>
                <li class="nav_links_text"><a href="/discord"><img src="/resources/icons/sections/discord_icon.png" alt="Discusión">Discusión</a></li>
                <li class="nav_links_text"><a href="/clans"><img src="/resources/icons/sections/clans_icon.png" alt="Clanes">Clanes</a></li>
                
                <!-- Menu desplegable de usuario -->
                <li class="dropdown">
                    <a href="/user-profile" class="dropdown-toggle">
                        <img src="/resources/icons/sections/user_icon.png" alt="Usuario">Usuario
                    </a>
                    <ul class="dropdown-menu">
                        <!-- Links para el usuario -->
                        <li><a href="/user/mail"><img src="/resources/icons/sections/mail_icon.png" alt="Correo">Correo</a></li>
                        <li><a href="/user/console"><img src="/resources/icons/sections/console_icon.png" alt="Consola">Consola</a></li>
                        <li><a href="/user/report"><img src="/resources/icons/sections/report_icon2.png" alt="Reportar">Reportar</a></li>
                        <li><a id="logout_link" href="#"><img src="/resources/icons/sections/logout_icon.png" alt="Cerrar Sesión">Cerrar Sesión</a></li>
                    </ul>
                </li>
            </ul>

            <!-- Logo dinamico de la pagina, se mueve hacia el upper_coating -->
            <div id="page-logo-container">
                <img id="page-logo" src="/resources/icons/logo/earendil_Logo.png" alt="Earendil Logo Grande">
            </div>
        </div>


    <div class="container">
        <h1 class="mb-4">Blogs</h1>
        
    <div class="container">
        <h1 class="mb-4"><%= article.title %> </h1>
        <div class="text-muted mb-2"><%=article.createdAt.toLocaleDateString() %></div>
        <a href="/articles" class="btn btn-secondary">Todos los blogs</a>

        <div><%- article.sanitizeHtml %></div>
        
    </div>
        <footer class="site-footer">
            <div class="footer-grid">
                
                <div class="footer-section">
                    <h4 class="footer-title">Explorar</h4>
                    <ul class="footer-links">
                        <li><a href="/news">Noticias</a></li>
                        <li><a href="/social">Comunidad Social</a></li>
                        <li><a href="/clans">Ranking de Clanes</a></li>
                        <li><a href="/wiki">Wiki & Guías</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4 class="footer-title">Soporte</h4>
                    <ul class="footer-links">
                        <li><a href="/report">Reportar un Jugador</a></li>
                        <li><a href="/faq">Preguntas Frecuentes (FAQ)</a></li>
                        <li><a href="/contact">Contacto de Soporte</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4 class="footer-title">Legal</h4>
                    <ul class="footer-links">
                        <li><a href="/terms">Términos de Servicio</a></li>
                        <li><a href="/privacy">Política de Privacidad</a></li>
                    </ul>
                </div>

                <div class="footer-section footer-copyright">
                    <img src="/resources/icons/logo/earendil_logo_mini.png" alt="Earendil Logo" class="footer-logo">
                    <p>&copy; 2025 Eärendil MC. Todos los derechos reservados.</p>
                    <p class="trademark">No afiliado a Mojang Studios.</p>
                </div>
            </div>

            <div class="footer-social">
                <a><img src="/resources/icons/sections/mail_icon.png" alt="Correo">earendil.official@gmail.com</a>
                <a href="https://www.youtube.com/@EarendilOfficial" target="_blank"><img src="/resources/icons/yt_icon.png" alt="Discord"> Youtube</a>
                <a href="https://www.instagram.com/earendiloficial/" target="_blank"><img src="/resources/icons/instagram_icon.png" alt="Instagram"> Instagram</a>
                </div>
        </footer>

        <div id="custom-alert" class="alert-modal">
            <div class="alert-content">
                <h3 id="alert-title">¡Error!</h3>
                <p id="alert-message">Algo salió mal. Por favor, inténtalo de nuevo.</p>
                <button id="alert-close">Aceptar</button>
            </div>
        </div>
        <script src="/resources/js/tooltip.js"></script>
        <script src="/pages/dashboard/script.js"></script> 
        <script src="/resources/js/announcement_Render.js"></script> 
    </body>
</html>