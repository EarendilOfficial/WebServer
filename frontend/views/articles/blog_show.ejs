<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Eärendil</title>
        <link rel="icon" type="image/x-icon" href="/resources/icons/logo/icon_A_mini.png">
        <link rel="stylesheet" href="/plantilla.css">
        <link rel="stylesheet" href="/resources/css/blogs.css">


    </head>

    <!-- /_ -->
    <!-- _/ -->

    <body id="body">

        <!-- Seccion de arriba donde se encuentra el logo oscurecido -->
        <%- include('../.parts/headerMini.ejs'); %>


        <div class="article-view-container">
    
            <!-- Título Principal -->
            <h1 class="article-title"><%= article.title %> </h1>
            
            <!-- Metadatos y Enlace -->
            <div class="article-meta-bar">
                <div class="article-date">
                    Publicado el <%= article.createdAt.toLocaleDateString() %>
                </div>
                
                <a href="/news" class="btn btn-secondary green-button back-button">
                    Todos los Blogs
                </a>
            </div>

            <!-- Contenido Principal -->
            <div class="article-content-panel gui-window">
                <%- article.sanitizeHtml %>
            </div>
            
        </div>
        
        <%- include('../.parts/footer.ejs'); %>
        <script src="/pages/dashboard/script.js"></script> 
        <script src="/resources/js/announcement_Render.js"></script> 
    </body>
</html>