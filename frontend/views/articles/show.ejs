<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Eärendil - Admin <%= article.title %> </title>
        <link rel="icon" type="image/x-icon" href="/resources/icons/logo/icon_A_mini.png">
        
        <link rel="stylesheet" href="/plantilla.css"> 
        <link rel="stylesheet" href="/pages/dashboard/style.css"> 
        <link rel="stylesheet" href="/resources/css/blogs.css">

    </head>

    <body id="body">
        <!-- Añadi header del sitio web -->
        <%- include('../.parts/headerAdmin.ejs'); %>


        <!-- Contenido del sitio web para los administradores -->
        <div class="article-view-container">

            <!-- Titulo del articulo -->
            <h1 class="article-title"><%= article.title %> </h1>
            
            <div class="article-date"><%=article.createdAt.toLocaleDateString() %></div>
            <a href="/admin/admin-blogs/" class="btn btn-secondary back-button">Todos los blogs</a>
            <a href="/admin/admin-blogs/edit/<%= article.id %>" class="green-button">Editar</a>

            <div class="article-content-panel gui-window">
            <%- article.sanitizeHtml %>
            </div>
            
        </div>
    
    
        <%- include('../.parts/footer.ejs'); %>
        <div id="custom-alert" class="alert-modal">...</div>
        <script src="/pages/edit_announcements/admin_styles.js"></script> 
        <script src="/resources/js/announcement_Render.js"></script> 
</body>
</html>