<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8" name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Edit User Profile</title>
        <link rel="icon" href="/resources/icons/logo/icon_A_mini.png">
        <link rel="stylesheet" href="/plantilla.css">
        <link rel="stylesheet" href="/pages/profile-edit/styles.css">
        <link rel="stylesheet" href="/pages/profile/styles.css">
        <link rel="stylesheet" href="/pages/dashboard/playerdata.css">
        <link rel="stylesheet" href="/resources/css/notifications.css">
    </head>

    <body id="body">
        <%- include("../.parts/headerMini") %>

        <%
            // Datos de minecraft
            const minecraftStats = minecraftData.stats;
            const isBlocked = user.moderation.is_blocked;
        %>

        <div id="title-profile">
            <!-- El título principal se mantiene simple -->
            <h1 class="username-title">
                Editar tu perfil 
                <% if (isBlocked) { %>
                    <span class="debt-warning">[DESHABILITADO]</span>
                <% } %>
            </h1>
        </div>

    <!---------------------------------------------- -->
        <!-- Contenido principal de la pagina -->
    <!---------------------------------------------- -->
        <main id="content" class="profile-main">
            <div class="profile-layout-grid">
                

                <!-- TARJETA DE PERFIL -->
                <div class="profile-card">

                    <!-- Cabezal de la pagina, informacion del usuario -->
                    <div class="header-profile">
                            <img class="profile-avatar" src="/resources/icons/sections/user_icon.png" alt="Avatar">
                            <textarea id="username" spellcheck="false" class="big-text-area important" placeholder="Usuario"><%- user.username %></textarea>
                    </div>
                    
                    <% if (isBlocked) { %>
                        <!-- Panel de Moderación -->
                        <div class="moderation-status">
                            <h4 class="block-reason-title">CUENTA BLOQUEADA TEMPORALMENTE</h4>
                            <p><strong>Motivo:</strong> <%= user.moderation.block_reason %></p>
                            <p>Bloqueado desde: <%= user.moderation.from_what[0] %></p>
                        </div>
                    <% } %>

                    <% if (!isBlocked) { %>
                        <h3 class="card-title" style="margin-top: 20px;"> Editar informacion de perfil</h3>
                        <div class="profile-stats">
                            <div class="stat-row">
                                <span class="stat-label">Correo:</span>
                                <textarea id="mail" class="medium-text-area" spellcheck="false" placeholder="tucorreo@ejemplo.com"><%- user.mail || '' %></textarea>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Teléfono:</span>
                                <textarea id="phoneNumber" class="medium-text-area" spellcheck="false" placeholder="Numero de telefono"><%= user.phoneNumber || '' %></textarea>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Cuenta MC:</span>
                                <textarea id="mcAccount" class="medium-text-area important" spellcheck="false" placeholder="Tu cuenta de Minecraft"><%= user.mcAccount || '' %></textarea>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Fecha de Registro:</span>
                                <span class="stat-value"><%= user.registration_date.toLocaleDateString() %></span>
                            </div>
                        </div>
                        <div class="edit-buttons" style="margin-top: 20px; text-align: center;">
                            <!-- Guardar cambios boton -->
                            <button id="save-changes" class="action-button">Guardar cambios</button>
                        </div>
                    <% } %>
                    
                </div>
                
                
            </div>
        </main>

        <%- include("../.parts/footer") %>
        
        <%- include("../.parts/notificationDetailModal") %>
        <script src="/pages/profile-edit/edit-profile.js"></script>  
        <script src="/resources/js/announcement_Render.js"></script> 
    </body>
</html>