<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8" name="viewport" content="width=device-width, initial-scale=1.0">
        <title>User Profile</title>
        <link rel="icon" href="/resources/icons/logo/icon_A_mini.png">
        <link rel="stylesheet" href="/plantilla.css">
        <link rel="stylesheet" href="/pages/profile/styles.css">
        <link rel="stylesheet" href="/pages/dashboard/playerdata.css">
        <link rel="stylesheet" href="/resources/css/notifications.css">
    </head>

    <body id="body">
        <%- include("../.parts/headerMini") %>

        <%
            // Datos de minecraft
            const minecraftStats = minecraftData.stats;
            const isBlocked = user.moderation.is_blocked;
        %>

        <div id="title-profile">
            <!-- El título principal se mantiene simple -->
            <h1 class="username-title">
                Perfil de <%= user.username %> 
                <% if (isBlocked) { %>
                    <span class="debt-warning">[DESHABILITADO]</span>
                <% } %>
            </h1>
        </div>

        <main id="content" class="profile-main">

            <div class="profile-layout-grid">
                
                <!-- Columna Izquierda: Información Personal y Contacto -->
                <div class="main-info-row">
                    
                    <!-- TARJETA 1: INFO BÁSICA Y MODERACIÓN -->
                    <div class="profile-card user-info-card">
                        <div class="card-header">
                            <img class="profile-avatar" src="/resources/icons/sections/user_icon.png" alt="Avatar">
                            <h2 class="username-title"><%= user.username %></h2>
                            <span class="group-mod" style="margin-left: 10px;"><%= user.groups.join(', ') %></span>
                        </div>
                        
                        <% if (isBlocked) { %>
                            <!-- Panel de Moderación -->
                            <div class="moderation-status">
                                <h4 class="block-reason-title">CUENTA BLOQUEADA TEMPORALMENTE</h4>
                                <p><strong>Motivo:</strong> <%= user.moderation.block_reason %></p>
                                <p>Bloqueado desde: <%= user.moderation.from_what[0] %></p>
                            </div>
                        <% } %>

                        <% if (!isBlocked) { %>
                            <h3 class="card-title" style="margin-top: 20px;"> Datos de Contacto</h3>
                            <div class="profile-stats">
                                <div class="stat-row">
                                    <span class="stat-label">Correo:</span>
                                    <span class="stat-value"><%= user.mail %></span>
                                </div>
                                <div class="stat-row">
                                    <span class="stat-label">Teléfono:</span>
                                    <span class="stat-value"><%= user.phoneNumber || 'N/A' %></span>
                                </div>
                                <div class="stat-row">
                                    <span class="stat-label">Cuenta MC:</span>
                                    <span class="stat-value mc-account-tag"><%= user.mcAccount %></span>
                                </div>
                                <div class="stat-row">
                                    <span class="stat-label">Registro:</span>
                                    <span class="stat-value"><%= user.registration_date.toLocaleDateString() %></span>
                                </div>
                            </div>
                            <div class="edit-buttons" style="margin-top: 20px; text-align: center;">
                                <button id="edit-profile" class="action-button">Editar Perfil</button>
                                <button id="change-password" class="action-button">Cambiar Contraseña</button>
                            </div>
                        <% } %>
                    </div>

                    <!-- NOTIFICACIONES -->
                    <div class="profile-card notifications-card">
                        <h3 class="card-title">Notificaciones (<span id="unread-count">0</span> Nuevas)</h3>
                        <div id="notifications-container" class="notification-list-scroll">
                            <!-- Las notificaciones se renderizarán aquí -->
                        </div>
                    </div>
                    
                </div>
                
                
                <!-- TARJETA 4: ACTIVIDAD -->
                <div class="profile-card activity-card">
                    <h3 class="card-title">Actividad Reciente</h3>
                    
                    <p class="section-subtitle">Actividad de Inicio de Sesión:</p>

                    <div class="weekly-activity-graph">
                    </div>

                    <div class="activity-line">
                        <p class="graph-label">Frecuencia Semanal: </p>
                    </div>

                    <p class="section-subtitle">Ultimos Logros/Trofeos:</p>
                    <div class="section-row">
                        <ul class="achievement-list">
                            <% user.achievements.forEach(ach => { %>
                                <li class="achievement-item <%= ach.rank %>">
                                    <%= ach.name %>
                                </li>
                            <% }); %>
                        </ul>
                        <!-- TODO -->
                        <!-- <button class="show-all-achievements-btn">Todos tus logros</button> -->
                    </div>
                    
                </div>


                <!-- Columna Derecha: Estadísticas MC y Actividad/Logros -->
                <div class="activity-achievements-row">
                    <!-- TARJETA 3: ESTADÍSTICAS MC -->
                    <div class="profile-card mc-stats-card">
                        <h3 class="card-title">Estadísticas de Minecraft</h3>
                            <div class="profile-stats">
                                <div class="stat-row">
                                <span class="stat-label">Nivel:</span>
                                <span id="player-level" class="stat-value"><%- minecraftStats.playerlevel %></span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Rango:</span>
                                <span id="player-rank" class="stat-value rank-color"></span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Ringcoins:</span>
                                <span id="player-ringcoins" class="stat-value money-yellow"><%- minecraftData.ringcoins %> 🪙</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Reputación:</span>
                                <span id="player-reputation" class="stat-value reputation-good"></span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Clan:</span>
                                <span id="player-clan" class="stat-value clan-tag">[ÉAR] Eärendil</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Misiones Completadas:</span>
                                <span id="player-finishedMissions" class="stat-value missions">42</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Kills:</span>
                                <span id="player-killcount" class="stat-value kill-count">987</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Horas Jugadas:</span>
                                <span class="stat-value"><%= minecraftStats.playtimeHours %>h</span>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA 2: ESTADO DE PAGO -->
                    <div class="profile-card financial-card">
                        <h3 class="card-title">Finanzas y Pagos</h3>
                        <div id="finances" class="profile-stats">
                            <div class="stat-row">
                                <span class="stat-label">Balance (Saldo a favor):</span>
                                <span class="stat-value money-balance"><%= user.balance %> MXN</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">Estado de Cuenta:</span>
                                <span id="account-state" class="stat-value status-active">Al Corriente</span>
                            </div>
                            <% if (user.payement.debtMonths.length > 0) { %>
                                <div class="stat-row">
                                    <span class="stat-label">DEUDA PENDIENTE:</span>
                                    <span class="stat-value debt-warning">¡<%= user.payement.debtMonths.length %> Meses!</span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="clan-payement-info">

                </div>

            </div>
        </main>

        <%- include("../.parts/footer") %>
        
        <%- include("../.parts/notificationDetailModal") %>
        <script src="/pages/profile/user.js"></script> 
        <script src="/resources/js/announcement_Render.js"></script> 
    </body>
</html>