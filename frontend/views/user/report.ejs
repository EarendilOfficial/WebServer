<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Eärendil</title>
        <link rel="icon" type="image/x-icon" href="../resources/icons/logo/icon_A_mini.png">
        <link rel="stylesheet" href="/plantilla.css">
        <link rel="stylesheet" href="/pages/report/styles.css">
    </head>

    <!-- /_ -->
    <!-- _/ -->

    <body id="body">
        
        <!-- Barra de arriba (o header) de la pagina web -->
        <%- include('../.parts/headerMini') %>


        <!-- CUERPO PRINCIPAL DEL SITIO WEB -->
        <!--            inicia              -->
        <!--   CUERPO PRINCIPAL DE PANELES  -->
        <div id="title" class="gui-window">
            <h1>Reportar jugadores</h1>
        </div>

        <main class="report-main-grid">

            
            <section id="player-chooser" class="gui-window player-chooser-window">
                <h1 class="window-title">Buscar Jugador</h1>
                
                <input type="text" id="player-search" placeholder="Buscar por nombre de usuario...">
                
                <div id="player-list" class="list-container">
                    <div class="player-item" data-username="Steve_MC">Steve_MC</div>
                    <div class="player-item selected" data-username="Alex_Builder">Alex_Builder</div>
                    <div class="player-item" data-username="Griefer_X">Griefer_X</div>
                </div>
            </section>

            <section id="report-panel" class="gui-window report-options-window">
                <h2 class="window-title">Detalles del Reporte</h2>
                
                <div class="reason-section">
                    <h3 class="section-subtitle">¿Por qué quieres reportar a ese jugador?</h3>
                    
                    <ul class="reason-choose-list item-choose">
                        <li class="reason-item"><a data-reason-id="1">Acoso / Lenguaje Ofensivo</a></li>
                        <li class="reason-item"><a data-reason-id="2">Griefing / Destrucción</a></li>
                        <li class="reason-item"><a data-reason-id="3">Uso de Hacks / Trampas</a></li>
                        <li class="reason-item"><a data-reason-id="4">Publicaciones inapropiadas / Imagenes ofensivas</a></li>
                        <li class="reason-item"><a data-reason-id="5">Otra razón</a></li>
                    </ul>
                </div>
                
                <div class="detail-section">
                    <h3 class="section-subtitle">Añadir Detalles:</h3>
                    <textarea id="report-details" placeholder="Describe brevemente la situación..."></textarea>
                </div>
                
                <button id="submit-report-btn" class="action-button">Enviar Reporte</button>
            </section>
        </main>

        
        <!-- Footer del sitio web (Panel de info general al fondo de la pagina) -->
        <%- include('../.parts/footer') %>

        <script src="/pages/report/player_report.js"></script> 
        <script src="/resources/js/announcement_Render.js"></script> 
    </body>
</html>